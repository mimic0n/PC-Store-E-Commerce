                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Laptop ASUS ROG Strix G15\",\n    \"description\": \"Laptop gaming cao cấp với RTX 4060, AMD Ryzen 7, 16GB RAM, 512GB SSD\",\n    \"price\": 35990000,\n    \"salePrice\": 32990000,\n    \"quantity\": 50,\n    \"images\": [\n        {\n            \"url\": \"https://res.cloudinary.com/your-cloud/image/upload/v1234/products/laptop1.jpg\",\n            \"publicId\": \"products/laptop1\"\n        },\n        {\n            \"url\": \"https://res.cloudinary.com/your-cloud/image/upload/v1234/products/laptop2.jpg\",\n            \"publicId\": \"products/laptop2\"\n        }\n    ],\n    \"thumbnail\": \"https://res.cloudinary.com/your-cloud/image/upload/v1234/products/laptop1.jpg\",\n    \"brand\": \"ASUS\",\n    \"specifications\": {\n        \"cpu\": \"AMD Ryzen 7 7735HS\",\n        \"ram\": \"16GB DDR5\",\n        \"storage\": \"512GB NVMe SSD\",\n        \"gpu\": \"NVIDIA RTX 4060 8GB\",\n        \"display\": \"15.6 inch FHD 144Hz\",\n        \"weight\": \"2.3kg\"\n    },\n    \"categoryId\": 1,\n    \"isFeatured\": true,\n    \"isActive\": true\n}"
                        },
                        "url": {
